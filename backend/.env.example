[TEMPLATE]
# Optional AI explanation service (OpenAI-compatible, e.g. Groq).
# Without a key the symptom checker still works fully using the built-in
# deterministic triage engine with template explanations.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=10

# Optional TURN server for WebRTC consultations.
# Only needed when clients are behind strict NATs / restrictive mobile
# networks where direct peer-to-peer fails. Credentials are served to the
# authenticated Flutter app at runtime via GET /api/consultations/turn-config
# and are NEVER baked into the app source code.
# Leave all three empty to use public STUN only (fine for most networks).
# TURN_SERVER_URL=turn:your-turn.example.com:3478?transport=udp
# TURN_SERVER_URL_TCP=turn:your-turn.example.com:3478?transport=tcp
# TURN_USERNAME=your_username
# TURN_CREDENTIAL=your_credential
