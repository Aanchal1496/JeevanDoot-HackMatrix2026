# Optional AI explanation service (OpenAI-compatible, e.g. Groq).
# Without a key the symptom checker still works fully using the built-in
# deterministic triage engine with template explanations.
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=10
