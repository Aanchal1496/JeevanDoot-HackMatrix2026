# ---------------------------------------------------------------------------
# OS / editor cruft
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.Trash-*

# ---------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.iml

# ---------------------------------------------------------------------------
# Python / FastAPI backend
# (backend/.gitignore holds the authoritative backend ignores; this is a
# root-level safety net so nothing sensitive sneaks in from anywhere.)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.env
.env.*
!.env.example
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
backend/nohup.out
nohup.out

# Local SQLite database (auto-created and seeded on startup by app/seed.py)
backend/app/*.db
*.db
*.sqlite
*.sqlite3

# Node (kept in case the backend ever uses npm tooling)
backend/node_modules/
node_modules/

# ---------------------------------------------------------------------------
# Flutter (root-level safety; jeevandoot/.gitignore already covers the rest)
# ---------------------------------------------------------------------------
jeevandoot/.dart_tool/
jeevandoot/build/
jeevandoot/.flutter-plugins
jeevandoot/.flutter-plugins-dependencies
jeevandoot/.packages
jeevandoot/android/local.properties
jeevandoot/ios/Flutter/Generated.xcconfig
jeevandoot/ios/Flutter/ephemeral/
jeevandoot/ios/Flutter/flutter_export_environment.sh
jeevandoot/ios/Flutter/.last_build_id
jeevandoot/macos/Flutter/ephemeral/
jeevandoot/linux/flutter/ephemeral/
jeevandoot/windows/flutter/ephemeral/

# ---------------------------------------------------------------------------
# Logs / misc
# ---------------------------------------------------------------------------
*.log
# Windows - often auto-generated by editor tooling
Thumbs.db
desktop.ini